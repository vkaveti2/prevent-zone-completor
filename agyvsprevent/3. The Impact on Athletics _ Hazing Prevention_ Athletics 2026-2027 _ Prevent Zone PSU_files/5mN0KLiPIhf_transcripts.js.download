
(function() {
    const data = {"transcripts":[{"name":"captions","cues":[{"start":1068,"text":"I'm living my dream."},{"start":2841,"text":"I've been playing this sport since I was four."},{"start":5553,"text":"I've spent early mornings, nights, weekends, and summers"},{"start":9070,"text":"practicing so I can earn playing time."},{"start":12189,"text":"Competition fuels me."},{"start":14489,"text":"Performing at my best is part of who I am."},{"start":18517,"text":"I have designed my entire life to be a winner."},{"start":21585,"text":"My passion for playing brought me here,"},{"start":23627,"text":"where I can earn my degree and play on a team with people like you,"},{"start":27457,"text":"who take this sport as seriously as I do."},{"start":31357,"text":"But honestly I didn't think it would be like this."},{"start":34057,"text":"I must be wrong about what it means to play on a college team."},{"start":37321,"text":"I find the constant demands of classes, practices, therapy sessions, workouts, "},{"start":42661,"text":"and games hard to manage and still stay strong."},{"start":47393,"text":"Actually I feel weak."},{"start":50081,"text":"I'm worn down."},{"start":51513,"text":"The bonds I had hoped for seem unattainable."},{"start":55189,"text":"On this team, I feel it's impossible to fit in."},{"start":58537,"text":"It seems that my ability to play well doesn't count."},{"start":61897,"text":"I'm given demeaning tasks, humiliated, "},{"start":64529,"text":"and told my experience would get worse if I don't comply or if I tell anyone."},{"start":69957,"text":"It seemed like my place on the team depended on following these directions."},{"start":75185,"text":"I was told the coach approves."},{"start":77393,"text":"I was told everyone must go through this."},{"start":80057,"text":"I was told this is the way we've always done it."},{"start":83077,"text":"I was told that I have no value without this team."},{"start":87285,"text":"I became a person I didn't recognize."},{"start":90057,"text":"And that's exactly what they wanted."},{"start":92513,"text":"But then I started talking."},{"start":95057,"text":"I started questioning."},{"start":97057,"text":"I started learning."},{"start":99107,"text":"What I found out is that I'm not alone"},{"start":101879,"text":"and neither are you."}]}]};
    window.globalLoadJsAsset('story_content/5mN0KLiPIhf_transcripts.js', JSON.stringify(data));
})();