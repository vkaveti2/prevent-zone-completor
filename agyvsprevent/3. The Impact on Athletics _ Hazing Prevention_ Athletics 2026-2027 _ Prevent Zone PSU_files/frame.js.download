idelink","slideid":"_player.67zX76TiVCa.6MoNnD2edE9","slidetitle":"We Don\'t Haze Here: Video","displaytext":"We Don&apos;t Haze Here: Video","expand":false,"type":"slide"},{"kind":"slidelink","slideid":"_player.67zX76TiVCa.5qzaGnWGphZ","slidetitle":"You Have the Power","displaytext":"You Have the Power","expand":false,"type":"slide"},{"kind":"slidelink","slideid":"_player.67zX76TiVCa.5emfzJCk5Pu","slidetitle":"You Have the Power (cont.)","displaytext":"You Have the Power (cont.)","expand":false,"type":"slide"},{"kind":"slidelink","slideid":"_player.67zX76TiVCa.6CQ7MwwCy6N","slidetitle":"Gold Medal","displaytext":"Gold Medal","expand":false,"type":"slide"},{"kind":"slidelink","slideid":"_player.67zX76TiVCa.5XNYzVXXg86","slidetitle":"Conclusion","displaytext":"Conclusion","expand":false,"type":"slide"}]}},"resourceData":{"description":"<p align=\'left\'><font face=\'Open Sans\' style=\'font-size: 11px;\' size=\'11\' color=\'#464646\'>Here are some useful links and documents:</font></p>","resources":[{"kind":"resource","url":"https://hazingpreventionnetwork.org/hank-nuwer-anti-hazing-hero-award/","image":"story_content/url.png","title":"Hank Nuwer Anti-Hazing Hero Award"},{"kind":"resource","url":"story_content/external_files/The Hazing Prevention Pledge.docx","image":"story_content/67XlTpkZr1R.png","title":"The Hazing Prevention Pledge (Download)"},{"kind":"resource","url":"https://hazingpreventionnetwork.org/pledge/","image":"story_content/url.png","title":"The Hazing Prevention Pledge (Website)"},{"kind":"resource","url":"https://www.youtube.com/embed/sUaH9zIZfog","image":"story_content/url.png","title":"How Hazing Impacts the Families"},{"kind":"resource","url":"https://prevent.zone/references/","image":"story_content/url.png","title":"References"},{"kind":"resource","url":"https://prevent.zone/smart-steps-4-staying-safe-2/","image":"story_content/url.png","title":"Smart Steps 4 Staying Safe™"},{"kind":"resource","url":"https://prevent.zone/team-building-activities-3/","image":"story_content/url.png","title":"Team-Building Activities"},{"kind":"resource","url":"https://prevent.zone/tips-for-team-leader/","image":"story_content/url.png","title":"Tips for the Team Leader"}]},"notesData":[{"slideId":"67zX76TiVCa.6FPl9Sn0y3G","slideBank":false,"content":"<p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 0px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:18.6667px; color:#000000;line-height:25.4205729166667px;\\"><b>Introduction</b></span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Being part of a team means looking out for your teammates and building a culture of respect. Understanding the impacts of hazing helps create an environment where everyone can always bring their A-game. In this module, we’ll explore hazing in athletic groups and the ways it can affect your team.</span></p>","notesPng":"","usePngNotesHtml5":false,"pathLib":"Lib","pathIndex":0},{"slideId":"67zX76TiVCa.5toec2g4Vkg","slideBank":false,"content":"<h1 style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 0px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:18.6667px; color:#000000;line-height:25.4205729166667px;\\"><b>Round 2</b></span></h1><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Great job in the last round! You earned enough points to earn two medals. Now, let’s go for the gold.</span></p>","notesPng":"","usePngNotesHtml5":false,"pathLib":"Lib","pathIndex":1},{"slideId":"67zX76TiVCa.5aZd5kb82MJ","slideBank":false,"content":"<p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 0px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:18.6667px; color:#000000;line-height:25.4205729166667px;\\"><b>Common Misconceptions</b></span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:21.7890625px;\\"><br></span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">You might think hazing is mostly a fraternity or sorority issue, but it also happens in athletics. Hazing can start in high school and carry over into college intramural and competitive teams.</span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Some argue that hazing serves a purpose because:</span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\"><br></span></p><ul class=\\"semantic-list\\"><li><p style=\'text-align:left;direction: ltr;padding-left: 12px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'ArialAAC91016\'; font-size:12px; color:#000000;line-height:32.68359375px; display: inline-block; text-align:left; min-width: 12px; margin-left: -12px;\\">•</span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">It brings our team closer together</span></p></li><li><p style=\'text-align:left;direction: ltr;padding-left: 12px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'ArialAAC91016\'; font-size:12px; color:#000000;line-height:32.68359375px; display: inline-block; text-align:left; min-width: 12px; margin-left: -12px;\\">•</span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">It weeds out weak team members </span></p></li><li><p style=\'text-align:left;direction: ltr;padding-left: 12px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'ArialAAC91016\'; font-size:12px; color:#000000;line-height:32.68359375px; display: inline-block; text-align:left; min-width: 12px; margin-left: -12px;\\">•</span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">It humbles new players</span></p></li><li><p style=\'text-align:left;direction: ltr;padding-left: 12px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'ArialAAC91016\'; font-size:12px; color:#000000;line-height:32.68359375px; display: inline-block; text-align:left; min-width: 12px; margin-left: -12px;\\">•</span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">It keeps our team traditions intact</span></p></li></ul><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">While some teams may believe this, it doesn’t make hazing okay.</span></p>","notesPng":"","usePngNotesHtml5":false,"pathLib":"Lib","pathIndex":2},{"slideId":"67zX76TiVCa.5dtIZGMaoWW","slideBank":false,"content":"<h1 style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 0px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:18.6667px; color:#000000;line-height:25.4205729166667px;\\"><b>Why do Student-Athletes Haze?</b></span></h1><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Student-athletes may participate in hazing for many social, psychological, and cultural reasons. Here are a few of the common ones. Select each to learn more.</span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\"><b>Groupthink</b></span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">: Groupthink is when individuals go along with what they believe the group wants or expects, even if they personally think it might be wrong or harmful. This causes them to make bad decisions or not fully think about the consequences of their actions.</span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\"><b>Cycles of Abuse</b></span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">: Individuals who have been victims of hazing are more likely to continue the behavior with other teammates. </span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\"><b>Perceived Lack of Alternatives</b></span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">: Student-athletes may think that what was done to them in the past, or what other teammates or coaches said they experienced, is acceptable. However, it’s important to offer better alternatives to replace old ways of thinking.</span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\"><br></span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Check out some positive alternatives with our Team Building Activities in the Resources tab. These activities were offered by students just like you while taking this course.</span></p>","notesPng":"","usePngNotesHtml5":false,"pathLib":"Lib","pathIndex":3},{"slideId":"67zX76TiVCa.5n2i3LjVCuc","slideBank":false,"content":"<p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 0px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:18.6667px; color:#000000;line-height:25.4205729166667px;\\"><b>You’re Not Alone</b></span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">I’m living my dream. I’ve been playing this sport since I was 4. I’ve spent early mornings, nights, weekends, and summers practicing so I can earn playing time. Competition fuels me. Performing at my best is part of who I am. I have designed my entire life to be a winner. My passion for playing brought me here, where I can earn my degree and play on a team with people like you, who take this sport as seriously as I do. </span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">But honestly, I didn’t think it would be like this. I must be wrong about what it means to play on a college team. I find the constant demands of classes, practices, therapy sessions, workouts, and games hard to manage and still stay strong. </span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Actually, I feel weak. I’m worn down. The bonds I had hoped for seem unattainable. On this team, I feel it’s impossible to fit in. It seems that my ability to play well doesn’t count. I’m given demeaning tasks, humiliated, and told my experience would get worse if I don’t comply or if I tell anyone. It seemed like my place on the team depended on following these directions. </span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">I was told the coach approves. I was told everyone must go through this. I was told this is the way we’ve always done it. I was told that I have no value without this team. I became a person I didn’t recognize. And that’s exactly what they wanted. But then I started talking. I started questioning. I started learning. What I found is that I am not alone. And neither are you.</span></p>","notesPng":"","usePngNotesHtml5":false,"pathLib":"Lib","pathIndex":4},{"slideId":"67zX76TiVCa.6J6gZv9bNUR","slideBank":false,"content":"<p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 0px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:18.6667px; color:#000000;line-height:25.4205729166667px;\\"><b>Fact Check 3</b></span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Here’s your chance to score your first point in round two!</span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">True or False. Hazing happens everywhere: in sports, band, fraternities and sororities, clubs, and ROTC.</span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">This is true! Hazing is not just a problem for fraternities and sororities. It can happen in any group. Be sure to look out for behaviors or activities that may cross the line.</span></p>","notesPng":"","usePngNotesHtml5":false,"pathLib":"Lib","pathIndex":5},{"slideId":"67zX76TiVCa.5ged9c8oSHx","slideBank":false,"content":"<p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 0px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:18.6667px; color:#000000;line-height:25.4205729166667px;\\"><b>Hazing Impacts the Individual</b></span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:21.7890625px;\\"><br></span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Hazing doesn’t just affect those being targeted — it impacts every level of the socio-ecological model (SEM) and the effects can last long after the incident.</span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">For the individual, hazing can cause physical injuries, emotional distress, and academic problems. Many students try to hide what they’re experiencing or don’t even realize how much it’s affecting them. </span></p>","notesPng":"","usePngNotesHtml5":false,"pathLib":"Lib","pathIndex":6},{"slideId":"67zX76TiVCa.6aYsyjHWfAL","slideBank":false,"content":"<p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 0px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:18.6667px; color:#000000;line-height:25.4205729166667px;\\"><b>Hazing Impacts Group Relationships</b></span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:21.7890625px;\\"><br></span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Hazing can also damage everyone on your team. If you or your teammates witness or participate in hazing, you may feel guilt, stress, or trauma. Your team’s season could be canceled. Perpetrators may face discipline, lawsuits, or criminal charges. Hazing can break trust, create fear, and destroy your team’s culture and reputation.</span></p>","notesPng":"","usePngNotesHtml5":false,"pathLib":"Lib","pathIndex":7},{"slideId":"67zX76TiVCa.6LUMjq6ow1J","slideBank":false,"content":"<p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 0px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:18.6667px; color:#000000;line-height:25.4205729166667px;\\"><b>Hazing Impacts the Community &amp; Society</b></span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:21.7890625px;\\"><br></span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Colleges and universities are affected too, facing lawsuits, loss of funding, and fewer student programs.</span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">And at the societal level, hazing has led to laws and mandatory hazing courses because of the serious harm it causes.</span></p>","notesPng":"","usePngNotesHtml5":false,"pathLib":"Lib","pathIndex":8},{"slideId":"67zX76TiVCa.6fCpxLO2gBY","slideBank":false,"content":"<h1 style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 0px;margin-bottom: 0pt\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:18.6667px; color:#000000;line-height:25.4205729166667px;\\"><b>Impacts of Hazing Activity</b></span></h1><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Now that you understand the impacts of hazing, we’ll show you several behaviors. Consider the effect that each activity has, then select all the levels that you think can be impacted.</span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Great job! It doesn’t matter how far you think the impacts reach - none of these activities are acceptable! If you&#39;re asked to participate in any of them to be part of a team, group, or club, don’t tolerate it! If you witness these things happening, do the right thing and speak up!</span></p>","notesPng":"","usePngNotesHtml5":false,"pathLib":"Lib","pathIndex":9},{"slideId":"67zX76TiVCa.5e27dkZDVDX","slideBank":false,"content":"<p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 0px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:18.6667px; color:#000000;line-height:25.4205729166667px;\\"><b>Power Dynamics</b></span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:21.7890625px;\\"><br></span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Since team captains and leaders have authority and influence, new and returning members may feel pressured to do whatever they say, even if it’s harmful. This power dynamic can make it difficult to speak out or raise concerns about certain activities. Some members choose to just “suck it up” and do whatever they say.</span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Some things that can contribute to unhealthy power dynamics are:</span></p><ul class=\\"semantic-list\\"><li><p style=\'text-align:left;direction: ltr;padding-left: 12px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'ArialAAC91016\'; font-size:12px; color:#000000;line-height:32.68359375px; display: inline-block; text-align:left; min-width: 12px; margin-left: -12px;\\">•</span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Power and Control</span></p></li><li><p style=\'text-align:left;direction: ltr;padding-left: 12px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'ArialAAC91016\'; font-size:12px; color:#000000;line-height:32.68359375px; display: inline-block; text-align:left; min-width: 12px; margin-left: -12px;\\">•</span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Alpha Male/Female</span></p></li><li><p style=\'text-align:left;direction: ltr;padding-left: 12px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'ArialAAC91016\'; font-size:12px; color:#000000;line-height:32.68359375px; display: inline-block; text-align:left; min-width: 12px; margin-left: -12px;\\">•</span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Alumni and Boosters</span></p></li><li><p style=\'text-align:left;direction: ltr;padding-left: 12px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'ArialAAC91016\'; font-size:12px; color:#000000;line-height:32.68359375px; display: inline-block; text-align:left; min-width: 12px; margin-left: -12px;\\">•</span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Respect</span></p></li></ul><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Let’s explore these a bit more.</span></p>","notesPng":"","usePngNotesHtml5":false,"pathLib":"Lib","pathIndex":10},{"slideId":"67zX76TiVCa.62UBmGoobNC","slideBank":false,"content":"<p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 0px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:18.6667px; color:#000000;line-height:25.4205729166667px;\\"><b>Power and Control</b></span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:21.7890625px;\\"><br></span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Hazing is based on power and control. Since team members are looking for acceptance and belonging, leaders can use their power to control them. The control is often disguised as “tradition”, making the activity seem legitimate and discouraging any questions, even if it may seem dangerous.</span></p>","notesPng":"","usePngNotesHtml5":false,"pathLib":"Lib","pathIndex":11},{"slideId":"67zX76TiVCa.6ddqbD7NkIf","slideBank":false,"content":"<p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 0px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:18.6667px; color:#000000;line-height:25.4205729166667px;\\"><b>Alpha Male/Female</b></span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:21.7890625px;\\"><br></span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">The loudest or most dominant person on the team is sometimes seen as the “alpha”. While this may give them influence, they are not always right. Sometimes, they have their own agenda or vision for the team that is not aligned with the team’s true goal. </span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">It’s important to recognize the difference between a leader and a bully. A leader will direct the group and reinforce the team&#39;s values. A bully uses force or violence to gain power and control.</span></p>","notesPng":"","usePngNotesHtml5":false,"pathLib":"Lib","pathIndex":12},{"slideId":"67zX76TiVCa.6I9MItyIBha","slideBank":false,"content":"<p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 0px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:18.6667px; color:#000000;line-height:25.4205729166667px;\\"><b>Alumni and Boosters</b></span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:21.7890625px;\\"><br></span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">While most college students today understand that hazing is not allowed, some alumni or boosters may not. They may assume that their old traditions are still okay, and might try to use their power and influence to encourage unhealthy activities. If team culture is going to change, we must work with everyone connected to the program — past, present, and future. Talk to your coach or a trusted campus employee if you feel like you need help with alumni, boosters, or volunteers who are stuck in the past.</span></p>","notesPng":"","usePngNotesHtml5":false,"pathLib":"Lib","pathIndex":13},{"slideId":"67zX76TiVCa.6AzQio33s6R","slideBank":false,"content":"<p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 0px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:18.6667px; color:#000000;line-height:25.4205729166667px;\\"><b>Respect</b></span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:21.7890625px;\\"><br></span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Respect isn’t earned through abuse or hazing. It’s earned by modeling dependability and integrity. If you try to force it, you’ll never truly gain your teammate’s respect. </span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">You don’t need a perfect GPA or to be the star athlete to earn respect. Instead, just make sure your words and actions always reflect the values that guide the team. If you’re asked to participate in an unhealthy activity, remember that you can say, “No!”</span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">For team leaders, leadership is about responsibility, not power. Hazing damages trust and can make teammates feel unsafe. Strong leaders earn respect by leading by example.</span></p>","notesPng":"","usePngNotesHtml5":false,"pathLib":"Lib","pathIndex":14},{"slideId":"67zX76TiVCa.64Knsp8hkKr","slideBank":false,"content":"<p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 0px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:18.6667px; color:#000000;line-height:25.4205729166667px;\\"><b>Tips for the Team Leader</b></span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:21.7890625px;\\"><br></span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">As a team leader, you&#39;ll have the chance to prevent hazing and promote healthy relationships among your team members.</span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Take a moment to review “Tips for the Team Leader” by selecting the Resources tab to familiarize yourself with ways to support your team, no matter what position or sport you play. </span></p>","notesPng":"","usePngNotesHtml5":false,"pathLib":"Lib","pathIndex":15},{"slideId":"67zX76TiVCa.5nIDf8GWSyo","slideBank":false,"content":"<p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 0px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:18.6667px; color:#000000;line-height:25.4205729166667px;\\"><b>Scenario 5.1</b></span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Time to score some points! Decide what’s Okay or Not Okay in the following scenarios.</span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">After practice, the team meets to brainstorm ideas for their fundraising goal. New players are invited to suggest ways to raise money, and the team votes on which ideas to carry out together.</span></p>","notesPng":"","usePngNotesHtml5":false,"pathLib":"Lib","pathIndex":16},{"slideId":"67zX76TiVCa.5fe8EEPDltW","slideBank":false,"content":"<p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 0px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:18.6667px; color:#000000;line-height:25.4205729166667px;\\"><b>Scenario 5.2</b></span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">New players must raise all the money for the fundraising target because that&#39;s how it’s always been done.</span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Everyone should be responsible for contributing to a team goal. Requiring only a specific group to do the work while excluding others is hazing.</span></p>","notesPng":"","usePngNotesHtml5":false,"pathLib":"Lib","pathIndex":17},{"slideId":"67zX76TiVCa.5yYJcGR1a5k","slideBank":false,"content":"<h1 style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 0px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:18.6667px; color:#000000;line-height:25.4205729166667px;\\"><b>Introduction to Smart Steps 4 Staying Safe™</b></span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:14.6667px; color:#000000;line-height:25.4205729166667px;\\"><br></span></h1><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Smart Steps 4 Staying Safe</span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\"><sup>TM</sup></span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\"> is an intervention model anyone can use if hazing is being planned or carried out. By working through these steps, you can do your part to stop the situation or get you and others to safety.  </span></p>","notesPng":"","usePngNotesHtml5":false,"pathLib":"Lib","pathIndex":18},{"slideId":"67zX76TiVCa.6S0DqfcEbgk","slideBank":false,"content":"<p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 0px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:18.6667px; color:#000000;line-height:25.4205729166667px;\\"><b>Preventing Hazing</b></span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">You can help prevent hazing with four steps:</span></p><ol class=\\"semantic-list\\"><li><p style=\'text-align:left;direction: ltr;padding-left: 24px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:12px; color:#464646;line-height:32.68359375px; display: inline-block; text-align:left; min-width: 24px; margin-left: -24px;\\">1.</span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Assess the Situation.</span></p></li><li><p style=\'text-align:left;direction: ltr;padding-left: 24px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:12px; color:#464646;line-height:32.68359375px; display: inline-block; text-align:left; min-width: 24px; margin-left: -24px;\\">2.</span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Speak Out.</span></p></li><li><p style=\'text-align:left;direction: ltr;padding-left: 24px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:12px; color:#464646;line-height:32.68359375px; display: inline-block; text-align:left; min-width: 24px; margin-left: -24px;\\">3.</span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Remove Yourself.</span></p></li><li><p style=\'text-align:left;direction: ltr;padding-left: 24px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:12px; color:#464646;line-height:32.68359375px; display: inline-block; text-align:left; min-width: 24px; margin-left: -24px;\\">4.</span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Report.</span></p></li></ol><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">These steps may sound easy and simple, but because of group pressure and power dynamics, it’s a good idea to think through how you might handle different situations.</span></p>","notesPng":"","usePngNotesHtml5":false,"pathLib":"Lib","pathIndex":19},{"slideId":"67zX76TiVCa.68aIy0ASXWc","slideBank":false,"content":"<p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 0px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:18.6667px; color:#000000;line-height:25.4205729166667px;\\"><b>Before Hazing Starts</b></span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">If you are a team or group leader, the best time to prevent hazing is before it starts. You can do this by dealing with it as soon as you hear unhealthy activities are being planned. Follow the four steps before the hazing unfolds.</span></p><ol class=\\"semantic-list\\"><li><p style=\'text-align:left;direction: ltr;padding-left: 24px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:12px; color:#464646;line-height:32.68359375px; display: inline-block; text-align:left; min-width: 24px; margin-left: -24px;\\">1.</span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Assess the Situation</span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">. Listen to what’s being planned and determine if it’s risky.</span></p></li><li><p style=\'text-align:left;direction: ltr;padding-left: 24px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:12px; color:#464646;line-height:32.68359375px; display: inline-block; text-align:left; min-width: 24px; margin-left: -24px;\\">2.</span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Speak Out</span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">. If you feel it’s leaning towards hazing, now is your time to be a leader and redirect any planned activities. Explain all of the risks and possible consequences.</span></p></li><li><p style=\'text-align:left;direction: ltr;padding-left: 24px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:12px; color:#464646;line-height:32.68359375px; display: inline-block; text-align:left; min-width: 24px; margin-left: -24px;\\">3.</span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Remove Yourself. If the group insists on continuing, you have no choice but to say that you are NOT participating. Stand up for your values. </span></p></li><li><p style=\'text-align:left;direction: ltr;padding-left: 24px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:12px; color:#464646;line-height:32.68359375px; display: inline-block; text-align:left; min-width: 24px; margin-left: -24px;\\">4.</span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Report. Seek help from a trusted employee at the school, even if the event is going to be off campus. </span></p></li></ol><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">By following these steps, you will help keep yourself safe from legal or other consequences and will be doing your part to protect others.</span></p>","notesPng":"","usePngNotesHtml5":false,"pathLib":"Lib","pathIndex":20},{"slideId":"67zX76TiVCa.5nTImoWh74E","slideBank":false,"content":"<h1 style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 0px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:18.6667px; color:#000000;line-height:25.4205729166667px;\\"><b>In the Moment: Step 1</b></span></h1><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Sometimes, you don’t recognize hazing until it is happening around you. You can use the same four steps to try to prevent hazing in the moment or stop a situation from escalating. Start by assessing the situation and asking yourself some questions. </span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Select each question mark to reveal the questions you should ask yourself.</span></p><ul class=\\"semantic-list\\"><li><p style=\'text-align:left;direction: ltr;padding-left: 10px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'ArialAAC91016\'; font-size:12px; color:#464646;line-height:32.68359375px; display: inline-block; text-align:left; min-width: 10px; margin-left: -10px;\\">•</span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Is it risking or causing physical harm?</span></p></li><li><p style=\'text-align:left;direction: ltr;padding-left: 10px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'ArialAAC91016\'; font-size:12px; color:#464646;line-height:32.68359375px; display: inline-block; text-align:left; min-width: 10px; margin-left: -10px;\\">•</span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Is it causing embarrassment, harassment, or ridicule?</span></p></li><li><p style=\'text-align:left;direction: ltr;padding-left: 10px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'ArialAAC91016\'; font-size:12px; color:#464646;line-height:32.68359375px; display: inline-block; text-align:left; min-width: 10px; margin-left: -10px;\\">•</span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Will we have to keep this secret?</span></p></li><li><p style=\'text-align:left;direction: ltr;padding-left: 10px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'ArialAAC91016\'; font-size:12px; color:#464646;line-height:32.68359375px; display: inline-block; text-align:left; min-width: 10px; margin-left: -10px;\\">•</span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">What would happen if someone posts a picture or video of this on social media?</span></p></li><li><p style=\'text-align:left;direction: ltr;padding-left: 10px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'ArialAAC91016\'; font-size:12px; color:#464646;line-height:32.68359375px; display: inline-block; text-align:left; min-width: 10px; margin-left: -10px;\\">•</span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Is this illegal?</span></p></li><li><p style=\'text-align:left;direction: ltr;padding-left: 10px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'ArialAAC91016\'; font-size:12px; color:#464646;line-height:32.68359375px; display: inline-block; text-align:left; min-width: 10px; margin-left: -10px;\\">•</span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Is this wrong? </span></p></li></ul>","notesPng":"","usePngNotesHtml5":false,"pathLib":"Lib","pathIndex":21},{"slideId":"67zX76TiVCa.5hQAezR7IkA","slideBank":false,"content":"<h1 style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 0px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:18.6667px; color:#000000;line-height:25.4205729166667px;\\"><b>In the Moment: Step 2</b></span></h1><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Don’t stand by and give silent approval for the activity. Speak out! </span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">While it isn’t always easy, find at least one person in the group to talk to and gain support. </span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Ask questions like:</span></p><ul class=\\"semantic-list\\"><li><p style=\'text-align:left;direction: ltr;padding-left: 10px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'ArialAAC91016\'; font-size:12px; color:#464646;line-height:32.68359375px; display: inline-block; text-align:left; min-width: 10px; margin-left: -10px;\\">•</span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Is it worth the risk?</span></p></li><li><p style=\'text-align:left;direction: ltr;padding-left: 10px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'ArialAAC91016\'; font-size:12px; color:#464646;line-height:32.68359375px; display: inline-block; text-align:left; min-width: 10px; margin-left: -10px;\\">•</span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Who is going to take responsibility for this?</span></p></li><li><p style=\'text-align:left;direction: ltr;padding-left: 10px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'ArialAAC91016\'; font-size:12px; color:#464646;line-height:32.68359375px; display: inline-block; text-align:left; min-width: 10px; margin-left: -10px;\\">•</span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">What happens if this goes wrong and someone gets hurt?</span></p></li><li><p style=\'text-align:left;direction: ltr;padding-left: 10px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'ArialAAC91016\'; font-size:12px; color:#464646;line-height:32.68359375px; display: inline-block; text-align:left; min-width: 10px; margin-left: -10px;\\">•</span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">What are we really trying to do here?</span></p></li><li><p style=\'text-align:left;direction: ltr;padding-left: 10px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'ArialAAC91016\'; font-size:12px; color:#464646;line-height:32.68359375px; display: inline-block; text-align:left; min-width: 10px; margin-left: -10px;\\">•</span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">I’m not okay with this. Are you?</span></p></li></ul><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">No matter your role, you have the power to prevent a bad situation.</span></p>","notesPng":"","usePngNotesHtml5":false,"pathLib":"Lib","pathIndex":22},{"slideId":"67zX76TiVCa.5kfjOZfCsXp","slideBank":false,"content":"<h1 style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 0px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:18.6667px; color:#000000;line-height:25.4205729166667px;\\"><b>In the Moment: Step 3</b></span></h1><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">If the activity continues, you should safely remove yourself from the situation. </span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Depending on your comfort level, you could encourage others to leave with you. </span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Don’t put yourself in danger by physically intervening. </span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Do not drive away if you are under the influence of drugs or alcohol. </span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Just leave the area as quickly as possible and call for outside help.</span></p>","notesPng":"","usePngNotesHtml5":false,"pathLib":"Lib","pathIndex":23},{"slideId":"67zX76TiVCa.5ibVotzBJLQ","slideBank":false,"content":"<h1 style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 0px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:18.6667px; color:#000000;line-height:25.4205729166667px;\\"><b>In the Moment: Step 4</b></span></h1><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Don’t allow someone to die or suffer injuries. Do the right thing! Don’t hesitate! If life is in danger, call 911 immediately. </span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">If it is not a life-or-death situation, report hazing to the appropriate authorities. </span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">You will also want to ask yourself if the team, group, or club is right for you.</span></p>","notesPng":"","usePngNotesHtml5":false,"pathLib":"Lib","pathIndex":24},{"slideId":"67zX76TiVCa.5d8h9sXNWjb","slideBank":false,"content":"<h1 style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 0px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:18.6667px; color:#000000;line-height:25.4205729166667px;\\"><b>Do the Right Thing</b></span></h1><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Even though speaking up can be hard at times, it is the right thing to do. We hope you can use the Smart Steps 4 Staying Safe</span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\"><sup>TM</sup></span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\"> to help you prevent a dangerous hazing situation. Following these steps can help keep you out of trouble and keep you and your friends safe.</span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">You have a choice of how to respond when you encounter hazing. Doing the right thing is the best choice.</span></p>","notesPng":"","usePngNotesHtml5":false,"pathLib":"Lib","pathIndex":25},{"slideId":"67zX76TiVCa.6juys8rdVxv","slideBank":false,"content":"<h1 style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 0px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:18.6667px; color:#000000;line-height:25.4205729166667px;\\"><b>Quick Check</b></span></h1><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Let’s review what you’ve learned with this quick quiz.</span></p>","notesPng":"","usePngNotesHtml5":false,"pathLib":"Lib","pathIndex":26},{"slideId":"67zX76TiVCa.6lWsACebqQk","slideBank":false,"content":"<p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 0px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:18.6667px; color:#000000;line-height:25.4205729166667px;\\"><b>Scenario 6.1</b></span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Let’s add to your score! Decide what’s Okay or Not Okay in the following scenarios.</span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">At the start of the semester, a co-ed intramural basketball team pairs new players up as “fianc&#233;s.” They are required to wear wedding clothes, read vows, and kiss during a wedding ceremony.</span></p>","notesPng":"","usePngNotesHtml5":false,"pathLib":"Lib","pathIndex":27},{"slideId":"67zX76TiVCa.6GdbBx6teCl","slideBank":false,"content":"<p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 0px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:18.6667px; color:#000000;line-height:25.4205729166667px;\\"><b>Scenario 6.2</b></span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">The co-ed intramural basketball team pairs teammates together. The pairs go through different basketball-themed stations, working as a team to score the most points.</span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Requiring team members to kiss someone else is an example of sexual hazing. This kind of activity is never okay. Rotating through basketball stations is a great alternative.</span></p>","notesPng":"","usePngNotesHtml5":false,"pathLib":"Lib","pathIndex":28},{"slideId":"67zX76TiVCa.6qaIZblKnHu","slideBank":false,"content":"<h1 style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 0px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:18.6667px; color:#000000;line-height:25.4205729166667px;\\"><b>Alcohol and Drugs</b></span></h1><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Alcohol, cannabis, and other drugs are often part of hazing activities. If you force or coerce someone to ingest these substances, you are risking their life and may be liable for their death or any injuries. Based on recent court cases, those responsible for buying or providing the alcohol, or coercing the binge drinking or drug use, can be prosecuted, sued, and held liable.</span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Some students may already have drugs in their system that you’re unaware of. Combining these substances with alcohol can cause dangerous, unintended outcomes. Do your part to make sure all activities are alcohol and drug-free.</span></p>","notesPng":"","usePngNotesHtml5":false,"pathLib":"Lib","pathIndex":29},{"slideId":"67zX76TiVCa.6p2dJzJxaol","slideBank":false,"content":"<h1 style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 0px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:18.6667px; color:#000000;line-height:25.4205729166667px;\\"><b>Reporting</b></span></h1><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">96% of students say that now that they’ve taken this course, they’ll most likely remove themselves and call 911 in dangerous hazing situations. Many of these situations have ended in death because no one called for help in time. This should NEVER happen, especially since calling 911 can help prevent it.</span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Additionally, if you don’t call for help, your team’s season could be canceled, and you and your teammates may be held responsible and arrested for participating in the hazing.</span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Calling for help is the most important thing to do in a life-threatening situation. You’ll learn specific ways to report hazing on your campus in the next module.</span></p>","notesPng":"","usePngNotesHtml5":false,"pathLib":"Lib","pathIndex":30},{"slideId":"67zX76TiVCa.5zn9ke2H6qU","slideBank":false,"content":"<p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 0px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:18.6667px; color:#000000;line-height:25.4205729166667px;\\"><b>Reporting Hazing Behaviors Activity</b></span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">There are many ways to report hazing. The best way to report can depend on the behavior.  Read each one, then select all the reporting methods that you think would be most appropriate.</span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Nice work! If you&#39;re asked to participate in any of these behaviors to be part of a group or club, don’t tolerate it. Remove yourself and report the hazing. If a life is in danger,  </span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\"><b>CALL 911</b></span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">!</span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\"></span></p>","notesPng":"","usePngNotesHtml5":false,"pathLib":"Lib","pathIndex":31},{"slideId":"67zX76TiVCa.5u5OVhPiY0C","slideBank":false,"content":"<p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 0px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:18.6667px; color:#000000;line-height:25.4205729166667px;\\"><b>Fact Check 4</b></span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Time to score another point!</span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">True or False: My parents, older siblings, and past coaches hazed others when they were in school, so it’s okay for me to do it now.</span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">It’s false! We now better understand the harm caused by hazing. Most states have laws against it. Schools, colleges, and clubs have also adopted no-hazing policies. Hazing is no longer acceptable.</span></p>","notesPng":"","usePngNotesHtml5":false,"pathLib":"Lib","pathIndex":32},{"slideId":"67zX76TiVCa.67szHEe2lgb","slideBank":false,"content":"<p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 0px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:18.6667px; color:#000000;line-height:25.4205729166667px;\\"><b>Check the Stats</b></span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Teams excel when they can bring in new members who add talent and commitment and help push the team toward championships. This can be difficult if your team is known for hazing.</span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Across North America, 98% of students believe that hazing is more than just a “harmless prank.” They recognize that it can have widespread and dangerous impacts.</span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Additionally, 84% of students say that if they know a team or group hazes, they wouldn’t join. Hazing on your team will make you miss out on really good talent. </span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Students looking to join your team will be encouraged to review the Hazing Transparency Report. If your team is on the report, it will negatively impact your ability to recruit new members. If you want the best members, don’t haze!</span></p>","notesPng":"","usePngNotesHtml5":false,"pathLib":"Lib","pathIndex":33},{"slideId":"67zX76TiVCa.6MoNnD2edE9","slideBank":false,"content":"<p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 0px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:18.6667px; color:#000000;line-height:25.4205729166667px;\\"><b>We Don’t Haze Here: Video</b></span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">When I look back on all I’ve accomplished and endured, I am proud to be a college athlete. In the past, I know I was hazed as a new athlete. Now I’m a team leader, and I vow to step up and make sure hazing doesn’t happen on my team.</span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">We don’t haze here. Or here. Or here.</span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">We have worked too hard to get here.</span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">We support each other, and understand it’s hard enough to be a student athlete.</span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">We know it’s an honor to be here, so we honor each other.</span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">We encourage, include, inspire, support, uplift, and embrace diversity.</span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">We don’t haze here.</span></p>","notesPng":"","usePngNotesHtml5":false,"pathLib":"Lib","pathIndex":34},{"slideId":"67zX76TiVCa.5qzaGnWGphZ","slideBank":false,"content":"<p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 0px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:18.6667px; color:#000000;line-height:25.4205729166667px;\\"><b>You Have the Power</b></span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:21.7890625px;\\"><br></span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">You have the power and the responsibility to shape your team&#39;s culture. By using your voice and taking action, you can challenge hazing behaviors. </span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">You can take a stand by: </span></p><ul class=\\"semantic-list\\"><li><p style=\'text-align:left;direction: ltr;padding-left: 12px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'ArialAAC91016\'; font-size:12px; color:#000000;line-height:32.68359375px; display: inline-block; text-align:left; min-width: 12px; margin-left: -12px;\\">•</span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Signing the Hazing Prevention Pledge</span></p></li><li><p style=\'text-align:left;direction: ltr;padding-left: 12px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'ArialAAC91016\'; font-size:12px; color:#000000;line-height:32.68359375px; display: inline-block; text-align:left; min-width: 12px; margin-left: -12px;\\">•</span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Volunteering or participating during National Hazing Prevention Week, and</span></p></li><li><p style=\'text-align:left;direction: ltr;padding-left: 12px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'ArialAAC91016\'; font-size:12px; color:#000000;line-height:32.68359375px; display: inline-block; text-align:left; min-width: 12px; margin-left: -12px;\\">•</span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Nominating a fellow member for the Hank Nuwer Hazing Prevention Hero Award. </span></p></li></ul>","notesPng":"","usePngNotesHtml5":false,"pathLib":"Lib","pathIndex":35},{"slideId":"67zX76TiVCa.5emfzJCk5Pu","slideBank":false,"content":"<p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 0px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:18.6667px; color:#000000;line-height:25.4205729166667px;\\"><b>You Have the Power (cont.)</b></span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:21.7890625px;\\"><br></span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Removing hazing from your team creates a culture where everyone can feel safe and accepted.</span></p>","notesPng":"","usePngNotesHtml5":false,"pathLib":"Lib","pathIndex":36},{"slideId":"67zX76TiVCa.6CQ7MwwCy6N","slideBank":false,"content":"<h1 style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 0px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:18.6667px; color:#000000;line-height:25.4205729166667px;\\"><b>Gold Medal</b></span></h1><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Congratulations! You’ve earned a gold medal.</span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Take some time to celebrate knowing that you have what it takes to identify hazing and to protect yourself and others from its impacts.</span></p>","notesPng":"","usePngNotesHtml5":false,"pathLib":"Lib","pathIndex":37},{"slideId":"67zX76TiVCa.5XNYzVXXg86","slideBank":false,"content":"<p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 0px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:18.6667px; color:#000000;line-height:25.4205729166667px;\\"><b>Conclusion</b></span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">You scored big in this course!  We covered:</span></p><ul class=\\"semantic-list\\"><li><p style=\'text-align:left;direction: ltr;padding-left: 12px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'ArialAAC91016\'; font-size:16px; color:#000000;line-height:32.68359375px; display: inline-block; text-align:left; min-width: 12px; margin-left: -12px;\\">•</span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Why hazing happens in athletics,</span></p></li><li><p style=\'text-align:left;direction: ltr;padding-left: 12px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'ArialAAC91016\'; font-size:16px; color:#000000;line-height:32.68359375px; display: inline-block; text-align:left; min-width: 12px; margin-left: -12px;\\">•</span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">How hazing can affect your team,</span></p></li><li><p style=\'text-align:left;direction: ltr;padding-left: 12px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'ArialAAC91016\'; font-size:16px; color:#000000;line-height:32.68359375px; display: inline-block; text-align:left; min-width: 12px; margin-left: -12px;\\">•</span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">How hazing impacts every level of the socio-ecological model,</span></p></li><li><p style=\'text-align:left;direction: ltr;padding-left: 12px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'ArialAAC91016\'; font-size:16px; color:#000000;line-height:32.68359375px; display: inline-block; text-align:left; min-width: 12px; margin-left: -12px;\\">•</span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">The Smart Steps 4 Staying Safe intervention model, and</span></p></li><li><p style=\'text-align:left;direction: ltr;padding-left: 12px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'ArialAAC91016\'; font-size:16px; color:#000000;line-height:32.68359375px; display: inline-block; text-align:left; min-width: 12px; margin-left: -12px;\\">•</span><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">Why reporting is always the right thing to do.</span></p></li></ul><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">We’ve put together some resources to help you advocate for hazing prevention on your campus. Be sure to check them out! </span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">You’ve officially finished “The Impact on Athletics” module.</span></p><p style=\'text-align:left;direction: ltr;padding-left: 0px;margin-top: 6px;margin-bottom: 6px;\'><span style=\\"font-family: \'Open SansD6FFC9F9\'; font-size:16px; color:#000000;line-height:32.68359375px;\\">To continue, select the Exit Activity button in your player and start the next activity when you’re ready.</span></p>","notesPng":"","usePngNotesHtml5":false,"pathLib":"Lib","pathIndex":38}]}');